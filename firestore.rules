rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resourceData) {
      return signedIn() && resourceData.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if false;
    }

    match /apps/{appId} {
      allow read: if resource.data.isPublished == true || owns(resource.data);
      allow write: if false;
    }

    match /appStats/{appId} {
      allow read: if owns(resource.data);
      allow write: if false;
    }

    match /appCheers/{reactionHash} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
